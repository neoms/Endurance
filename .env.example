# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# 日志文件（可选）：留空时开发默认 logs/app.log、生产默认不写（stdout 采集）；
# 显式指定则覆盖路径；off 关闭文件日志
# LOG_FILE=logs/app.log
# 单个日志文件上限（达到后轮转）与保留的历史文件数
LOG_FILE_MAX_SIZE=10m
LOG_FILE_KEEP=7
# 成功请求日志采样率（0-1，默认 1 全量；生产高流量建议调低，如 0.1）
REQUEST_LOG_SAMPLE_RATE=1
# 慢请求阈值（毫秒），超过则在请求日志标记 slow: true
SLOW_REQUEST_THRESHOLD_MS=2000

# Database (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=dev-only-secret-do-not-use-in-production
JWT_EXPIRES_IN=24h

# DeepSeek AI（可选）：配置后群组机器人/个人对话接入真实 DeepSeek 大模型；
# 留空或删除本行则自动回退到内置 Mock 模拟回复（零配置可运行）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# AI 回复缓存 TTL（毫秒）：同一对话/群组内相同问题在 TTL 内回放上次回复；0 表示关闭
AI_CACHE_TTL_MS=3600000
# AI 接口限流：每用户每个时间窗口（毫秒）内最多请求数（发送消息/重试）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
