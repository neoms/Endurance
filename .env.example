# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=dev-only-secret-do-not-use-in-production
JWT_EXPIRES_IN=24h

# DeepSeek AI（可选）：配置后群组机器人/个人对话接入真实 DeepSeek 大模型；
# 留空或删除本行则自动回退到内置 Mock 模拟回复（零配置可运行）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
